rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net - Default Deny all path requests
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable, hardened helpers
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Hardened validation for UserProgress
    function isValidUserProgress(data, userId) {
      return data.userId == userId
          && data.userId == request.auth.uid
          && data.currentLevelIndex is int
          && data.currentLevelIndex >= 0
          && data.currentLevelIndex <= 100
          && data.totalScore is int
          && data.points is int
          && data.coins is int
          && data.coins >= 0
          && data.unlockedBallIds is list
          && data.unlockedBallIds.size() > 0
          && data.unlockedBallIds.size() <= 500
          && data.equippedBallId is string
          && data.equippedBallId.size() <= 64
          && (!('unlockedTrailIds' in data) || (data.unlockedTrailIds is list && data.unlockedTrailIds.size() <= 500))
          && (!('equippedTrailId' in data) || (data.equippedTrailId is string && data.equippedTrailId.size() <= 64))
          && data.bestScores is map
          && data.resetUnlocked is bool
          && data.updatedAt == request.time;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      
      allow create: if isOwner(userId)
                    && isValidId(userId)
                    && isValidUserProgress(incoming(), userId);
                    
      allow update: if isOwner(userId)
                    && isValidId(userId)
                    && isValidUserProgress(incoming(), userId)
                    && incoming().userId == existing().userId; // Immutable UID integrity
                    
      allow delete: if false; // Progress cannot be deleted through client libraries
    }

    // Martin's Creator Exclusive Grants System
    match /exclusive_grants/{grantId} {
      // Allow read so client apps can check for granted exclusive items by email / account name
      allow read: if true;
      
      // Allow create, update, delete only by Martin's authorized creator account
      allow create, update, delete: if isSignedIn() && (
        request.auth.token.email == 'martin.luquetta@sgs.edu.co' ||
        request.auth.token.email.matches('(?i)martin\\.luquetta.*') ||
        (request.auth.token.name != null && request.auth.token.name.matches('(?i).*martin.*'))
      );
    }

    // Martin's Creator Player Ban Management System
    match /player_bans/{banId} {
      // Allow read so client apps can verify ban status upon connecting
      allow read: if true;
      
      // Allow create, update, delete only by Martin's authorized creator account
      allow create, update, delete: if isSignedIn() && (
        request.auth.token.email == 'martin.luquetta@sgs.edu.co' ||
        request.auth.token.email.matches('(?i)martin\\.luquetta.*') ||
        (request.auth.token.name != null && request.auth.token.name.matches('(?i).*martin.*'))
      );
    }

    // Real-Time Online Multiplayer Rooms & Matchmaking
    match /multiplayer_rooms/{roomId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isSignedIn();
    }
  }
}
